# Frontend configuration — run npm commands from this folder, not the repo root.
#
# In development the Vite dev server proxies /api to the backend, so the default
# below works with no changes. Set this explicitly when the frontend is deployed
# separately from the API (for example a static host plus a container backend).
VITE_API_BASE_URL=/api

# Where the dev-server proxy forwards /api. Only used by `npm run dev`.
VITE_DEV_API_TARGET=http://localhost:8000

# How long a request may hang before the console falls back to the last good data.
VITE_API_TIMEOUT_MS=15000
