# Copy to .env and adjust. Every value has a working default.

ENV=development
DATABASE_URL=sqlite:///./ner_ews.db
# Deployment: postgresql+psycopg://user:pass@host:5432/ner_ews
MEDIA_ROOT=./media
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# --- auth (off by default so the console needs zero setup) ---
AUTH_ENABLED=false
JWT_SECRET=dev-secret-change-me
JWT_TTL_HOURS=12

# --- risk bands: what the console DISPLAYS ---
RISK_BAND_CRITICAL=80
RISK_BAND_HIGH=60
RISK_BAND_MODERATE=35

# --- alert tiers: who gets an SMS (NDMA/GSI). Deliberately different numbers. ---
TIER_RED=86
TIER_ORANGE=66
TIER_YELLOW=41

# --- risk engine ---
W_STATIC=0.4
W_DYNAMIC=0.6
T_CRIT_24H=150
T_CRIT_72H=250
T_CRIT_7D=400
API_MAX=200
API_DECAY_K=0.85

# --- alert engine ---
DISPATCH_CUTOFF=60
ALERT_COOLDOWN_MIN=45
AUTO_RESOLVE_HOURS=24
LOW_CONFIDENCE_FLOOR=40
SOIL_SATURATION_PCT=80
TILT_DELTA_DEG=0.8

# --- delivery ---
SMS_PROVIDER=console          # console | http | store_forward
SMS_ENDPOINT=
SMS_API_KEY=
SMS_MAX_ATTEMPTS=4

# --- ingest ---
IMD_API_BASE=
IMD_API_KEY=
SCHEDULER_ENABLED=true
RISK_RECOMPUTE_SECONDS=900

# --- telemetry simulation ---
# The sensor fleet is driven by a physics-informed simulator: rainfall -> soil
# moisture -> pore pressure -> factor of safety -> creep -> risk. Set
# SIMULATOR_ENABLED=false when real gateways are ingesting via /api/ingest/readings;
# nothing else changes.
SIMULATOR_ENABLED=true
SIMULATOR_TICK_SECONDS=20
SIMULATOR_MINUTES_PER_TICK=15
SIMULATOR_SEED=20260901

# --- custom alert rules ---
CUSTOM_RULE_COOLDOWN_MIN=45

# --- trained-model inference ---
# Runs in-process on each risk cycle when scikit-learn/joblib/pandas are installed
# (pip install -r requirements-ml.txt). Without them every zone is scored by the
# rule engine, which is a complete early-warning system on its own.
# How long an externally published prediction (POST /api/model/predict) stays
# authoritative before the local engines resume scoring that zone. Bounded so a
# dead publishing pipeline cannot leave a stale score on the console forever.
MODEL_PUBLISH_TTL_MIN=60

# --- shared project data (defaults resolve to the repository's data/ tree) ---
# GIS_DATA_DIR=../data/gis
# ML_DATA_DIR=../data/ml
# REPORT_OUT_DIR=../reports

# Provenance label surfaced in the UI and on every generated report.
# Flip to OBSERVED once a real ingest is wired.
DATA_CONFIDENCE=SYNTHETIC
